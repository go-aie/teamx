{
  "schema_version": 1,
  "copy_policy": "explicit_files_only_no_recursive_directory_copy",
  "builds": [
    {
      "package": "./cmd/teamx",
      "destination": "bin/teamx"
    },
    {
      "package": "./tools/gitlab",
      "destination": "bin/teamx-gitlab"
    },
    {
      "package": "./tools/scion",
      "destination": "bin/teamx-scion"
    }
  ],
