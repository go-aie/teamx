    "internal/web/embed.go",
    "internal/platform/tool/skills.go",
    "internal/platform/gitlab/tools/git-askpass.sh"
  ],
  "generated_by_later_phases": [],
  "forbidden_sources": [
    ".teamx/config.toml",
    ".teamx/data/",
    ".env",
    ".env.*",
    "bin/",
    ".local/",
    "dist/",
    ".git/"
  ],
  "dependency_assets": "Only pinned artifacts from dependencies.lock.json and its explicit contract references; never copy the workspace bin directory.",
  "generated_files": [
    "manifest.json",
    "checksums.txt",
    "THIRD_PARTY_NOTICES/dsh-dependencies.json",
    "bin/git (full)",
    "runtime/glab (full)",
    "runtime/lark (full)",
    "runtime/git (full)",
    "THIRD_PARTY_NOTICES/git-source (full)",
    "THIRD_PARTY_NOTICES/git-materials.json (full)"
  ]
