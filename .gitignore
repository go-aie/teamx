# Local configuration and secrets
.env
.env.*
/config.toml

# OS files and development caches
.DS_Store
__pycache__/
*.py[cod]
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime data and binaries
# Runtime identities, credentials and workspace state are private by default.
# Only public configuration and team templates belong in version control.
/.teamx/*
!/.teamx/config.example.toml
!/.teamx/teams/
.local/
/data/
/bin/

# Distribution archives and isolated build state
/dist/
/.packaging/

# Local acceptance artifacts; keep implementation notes in version control
/docs/implementation/**/*.log
/docs/implementation/**/*.png
/docs/implementation/**/*.json
